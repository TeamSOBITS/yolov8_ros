<launch>
    <!-- weight file path -->
    <arg name="weights" default="$(find-pkg-share yolov8_ros)/weights/yolov8m.pt"/>    <!-- change the weight path -->

    <!-- probability -->
    <arg name="conf" default="0.3"/>

    <!-- Visualize using OpenCV window -->
    <arg name="view_image" default="true"/>

    <!-- Save result images -->
    <arg name="save_image" default="false"/>

    <!-- Publish Rate -->
    <arg name="pub_rate" default="5"/>

    <!-- image topic name-->
    <arg name="image_topic_name" default="/camera/camera/color/image_raw"/>    <!-- change the each camera -->

    <node pkg="yolov8_ros" name="yolov8" exec="detect_ros.py" output="screen">
        <param name="weights" value="$(var weights)"/>
        <param name="conf" value="$(var conf)"/>

        <param name="view_image" value="$(var view_image)"/>
        <param name="save_image" value="$(var save_image)"/>
        <param name="pub_rate"   value="$(var pub_rate)"/>

        <param name="execute_default" value="true"/>
        <param name="image_topic_name" value="$(var image_topic_name)"/>
    </node>
</launch>